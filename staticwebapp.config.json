{
	"navigationFallback": {
		"rewrite": "/index.html",
		"exclude": [
			"/api/*",
			"/assets/*",
			"/*.css",
			"/*.js",
			"/*.json",
			"/*.svg",
			"/*.png",
			"/*.jpg",
			"/*.ico"
		]
	},
	"responseOverrides": {
		"404": {
			"rewrite": "/index.html",
			"statusCode": 200
		}
	},
	"globalHeaders": {
		"X-Content-Type-Options": "nosniff",
		"X-Frame-Options": "DENY",
		"Referrer-Policy": "strict-origin-when-cross-origin"
	}
}
