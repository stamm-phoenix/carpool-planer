---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Fahrtenplanung">
  <div class="mb-8">
    <h1 class="font-serif text-3xl font-bold text-dpsg-blue mb-2">Fahrtenplanung</h1>
    <p id="event-title" class="text-xl text-dpsg-blue/80"></p>
    <p class="text-dpsg-blue/60 mt-1">Hin- und Rückfahrt getrennt planen, Leiter werden priorisiert.</p>
    <div class="mt-3 inline-flex items-center gap-2 text-sm bg-white border border-dpsg-beige-2 rounded px-3 py-1.5">
      <span id="mode-dot" class="inline-block h-2 w-2 rounded-full bg-dpsg-yellow"></span>
      <span id="mode-label" class="text-dpsg-blue">Lade Daten...</span>
    </div>
  </div>

  <section class="bg-white rounded-lg border border-dpsg-beige-2 p-5 mb-6 shadow-sm">
    <h2 class="font-serif text-lg font-bold text-dpsg-blue mb-3">Event auswählen</h2>
    <div id="error-box" class="hidden text-sm text-dpsg-red bg-dpsg-red/10 border border-dpsg-red/30 rounded px-3 py-2 mb-4"></div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
      <div class="md:col-span-2">
        <label for="event" class="block text-sm text-dpsg-blue mb-1">Event</label>
        <select id="event" class="w-full rounded border border-dpsg-beige-2 bg-white px-3 py-2 text-dpsg-blue"></select>
      </div>
      <div>
        <label for="hinCol" class="block text-sm text-dpsg-blue mb-1">Hinfahrt-Spalte</label>
        <select id="hinCol" class="w-full rounded border border-dpsg-beige-2 bg-white px-3 py-2 text-sm text-dpsg-blue"></select>
      </div>
      <div>
        <label for="rueckCol" class="block text-sm text-dpsg-blue mb-1">Rückfahrt-Spalte</label>
        <select id="rueckCol" class="w-full rounded border border-dpsg-beige-2 bg-white px-3 py-2 text-sm text-dpsg-blue"></select>
      </div>
    </div>
  </section>

  <div class="grid gap-6 lg:grid-cols-3 mb-6">
    <section class="lg:col-span-2 bg-white rounded-lg border border-dpsg-beige-2 p-5 shadow-sm">
      <h2 class="font-serif text-lg font-bold text-dpsg-blue mb-1">Teilnehmer</h2>
      <p class="text-sm text-dpsg-blue/60 mb-4">Fahrer haben Plätze &gt; 0 eingetragen</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
        <input id="filter-q" type="search" placeholder="Name oder Gruppe suchen" class="rounded border border-dpsg-beige-2 bg-white px-3 py-2 text-sm text-dpsg-blue" />
        <select id="filter-ride" class="rounded border border-dpsg-beige-2 bg-white px-3 py-2 text-sm text-dpsg-blue">
          <option value="all">Alle</option>
          <option value="drivers">Nur Fahrer</option>
          <option value="passengers">Nur Mitfahrende</option>
          <option value="hin">Fahrer Hinfahrt</option>
          <option value="rueck">Fahrer Rückfahrt</option>
        </select>
        <select id="filter-group" class="rounded border border-dpsg-beige-2 bg-white px-3 py-2 text-sm text-dpsg-blue">
          <option value="all">Alle Gruppen</option>
        </select>
      </div>

      <div class="overflow-auto max-h-80 border border-dpsg-beige-2 rounded">
        <table class="w-full text-sm">
          <thead class="bg-dpsg-beige-1 sticky top-0">
            <tr class="text-left text-dpsg-blue">
              <th class="px-3 py-2 font-semibold">Name</th>
              <th class="px-3 py-2 font-semibold">Gruppe</th>
              <th class="px-3 py-2 font-semibold text-center">Hin</th>
              <th class="px-3 py-2 font-semibold text-center">Rück</th>
            </tr>
          </thead>
          <tbody id="participants-body" class="divide-y divide-dpsg-beige-2"></tbody>
        </table>
      </div>
      <p id="source-label" class="text-xs text-dpsg-blue/50 mt-2"></p>
    </section>

    <section class="bg-white rounded-lg border border-dpsg-beige-2 p-5 shadow-sm">
      <h2 class="font-serif text-lg font-bold text-dpsg-blue mb-3">Fahrer-Priorität</h2>
      <p class="text-sm text-dpsg-blue/60 mb-4">Reihenfolge der Berücksichtigung</p>
      <ol id="priority-list" class="space-y-2"></ol>
    </section>
  </div>

  <section class="bg-white rounded-lg border border-dpsg-beige-2 p-5 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-5">
      <div>
        <h2 class="font-serif text-lg font-bold text-dpsg-blue">Fahrtenplanung</h2>
        <p class="text-sm text-dpsg-blue/60">Automatische Zuordnung nach Priorität. Mitfahrer anklicken zum Verschieben.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="export-csv" class="bg-dpsg-cyan text-white px-4 py-2 rounded font-semibold" type="button">CSV Export</button>
        <button id="copy-csv" class="bg-dpsg-beige-2 text-dpsg-blue px-4 py-2 rounded font-semibold" type="button">Kopieren</button>
        <button id="reset-moves" class="bg-dpsg-red/10 text-dpsg-red px-4 py-2 rounded font-semibold border border-dpsg-red/30" type="button">Zurücksetzen</button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-5">
      <div id="hin-summary" class="rounded border border-dpsg-beige-2 bg-dpsg-beige-1/40 px-3 py-2 text-sm text-dpsg-blue"></div>
      <div id="rueck-summary" class="rounded border border-dpsg-beige-2 bg-dpsg-beige-1/40 px-3 py-2 text-sm text-dpsg-blue"></div>
    </div>

    <div id="plan-grid" class="grid gap-6 md:grid-cols-2"></div>
  </section>

  <script>
    // @ts-nocheck
    import { computePlan, applyManualMoves, parseMovesFromUrl, planToCsv, groupPriorityOrder, participantKey } from "../lib/planner";

    const DEFAULT_COLUMNS = {
      hinfahrtColumn: "col_K0HMI9HMkVblaqpBqFBu",
      rueckfahrtColumn: "col_tSMUO3gitt0dXFMOhWGq"
    };

    const state = {
      events: [],
      participants: [],
      columns: [],
      selectedEventId: "",
      selectedEventName: "",
      columnMapping: { ...DEFAULT_COLUMNS }
    };

    const els = {
      eventTitle: document.getElementById("event-title"),
      modeDot: document.getElementById("mode-dot"),
      modeLabel: document.getElementById("mode-label"),
      sourceLabel: document.getElementById("source-label"),
      errorBox: document.getElementById("error-box"),
      event: document.getElementById("event"),
      hinCol: document.getElementById("hinCol"),
      rueckCol: document.getElementById("rueckCol"),
      filterQ: document.getElementById("filter-q"),
      filterRide: document.getElementById("filter-ride"),
      filterGroup: document.getElementById("filter-group"),
      participantsBody: document.getElementById("participants-body"),
      priorityList: document.getElementById("priority-list"),
      hinSummary: document.getElementById("hin-summary"),
      rueckSummary: document.getElementById("rueck-summary"),
      planGrid: document.getElementById("plan-grid"),
      exportCsv: document.getElementById("export-csv"),
      copyCsv: document.getElementById("copy-csv"),
      resetMoves: document.getElementById("reset-moves")
    };

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function getGroupColorClass(group) {
      const g = (group || "").toLowerCase();
      if (g.includes("wölflinge") || g.includes("woelf")) return "bg-dpsg-woelflinge";
      if (g.includes("jungpfadfinder")) return "bg-dpsg-jupfis";
      if (g.includes("pfadfinder") && !g.includes("jung")) return "bg-dpsg-pfadfinder";
      if (g.includes("rover")) return "bg-dpsg-rover";
      if (g.includes("leitend") || g.includes("externe") || g.includes("ehemalige")) return "bg-dpsg-leiter";
      return "bg-dpsg-beige-2";
    }

    function getShortGroupName(group) {
      const g = (group || "").toLowerCase();
      if (g.includes("wölflinge") || g.includes("woelf")) return "Wö";
      if (g.includes("jungpfadfinder")) return "Jupfi";
      if (g.includes("pfadfinder") && !g.includes("jung")) return "Pfadi";
      if (g.includes("rover")) return "Rover";
      if (g.includes("leitend") || g.includes("externe") || g.includes("ehemalige")) return "Leiter";
      return "?";
    }

    function isWinterEvent(name) {
      return /winter\s*[-_ ]?\s*wochenende/i.test(name || "");
    }

    function url() {
      return new URL(window.location.href);
    }

    function getParam(name, fallback = "") {
      return url().searchParams.get(name) ?? fallback;
    }

    function setParam(name, value) {
      const next = url();
      if (value) next.searchParams.set(name, value);
      else next.searchParams.delete(name);
      window.history.replaceState({}, "", next);
    }

    function getStorageKey() {
      return `carpool-moves:${state.selectedEventId || "default"}`;
    }

    function readMovesParam(name) {
      const fromUrl = getParam(name, "");
      if (fromUrl) return fromUrl;

      try {
        const raw = window.localStorage.getItem(getStorageKey());
        if (!raw) return "";
        const parsed = JSON.parse(raw);
        return parsed?.[name] ?? "";
      } catch {
        return "";
      }
    }

    function writeMoves(hin, rueck) {
      setParam("movesHin", hin);
      setParam("movesRueck", rueck);
      try {
        window.localStorage.setItem(getStorageKey(), JSON.stringify({ movesHin: hin, movesRueck: rueck }));
      } catch {
      }
    }

    function normalizeParticipants(rows) {
      return rows
        .filter((p) => `${p.Vorname || ""}${p.Nachname || ""}`.trim().length > 0)
        .map((p) => ({
          ...p,
          Vorname: (p.Vorname || "").trim(),
          Nachname: (p.Nachname || "").trim(),
          Gruppen: (p.Gruppen || "").trim(),
          Hinfahrt: Number.isFinite(p.Hinfahrt) ? Math.max(0, Math.trunc(p.Hinfahrt)) : 0,
          Rückfahrt: Number.isFinite(p.Rückfahrt) ? Math.max(0, Math.trunc(p.Rückfahrt)) : 0
        }));
    }

    async function apiFetch(params) {
      const query = new URLSearchParams(params);
      const res = await fetch(`/api/campflow?${query.toString()}`);
      if (!res.ok) {
        let msg = `${res.status} ${res.statusText}`;
        try {
          const body = await res.json();
          if (body?.error) msg = body.error;
        } catch {
        }
        throw new Error(msg);
      }
      return res.json();
    }

    function buildPriorityList() {
      els.priorityList.innerHTML = groupPriorityOrder
        .map((g, i) => `<li class="flex items-center gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-dpsg-blue text-white text-xs font-bold flex items-center justify-center">${i + 1}</span><span class="px-2 py-1 rounded text-sm font-medium text-white ${getGroupColorClass(g)}">${escapeHtml(getShortGroupName(g))}</span></li>`)
        .join("");
    }

    function renderEventControls() {
      els.event.innerHTML = state.events
        .map((evt) => `<option value="${escapeHtml(evt.id)}" ${evt.id === state.selectedEventId ? "selected" : ""}>${escapeHtml(evt.name)} · ${escapeHtml(evt.startDate || "")}</option>`)
        .join("");

      const options = state.columns.length > 0 ? state.columns : [
        { id: state.columnMapping.hinfahrtColumn, name: state.columnMapping.hinfahrtColumn },
        { id: state.columnMapping.rueckfahrtColumn, name: state.columnMapping.rueckfahrtColumn }
      ];

      const unique = Array.from(new Map(options.map((o) => [o.id, o])).values());
      const optionHtml = unique.map((col) => `<option value="${escapeHtml(col.id)}">${escapeHtml(col.name || col.id)}</option>`).join("");
      els.hinCol.innerHTML = optionHtml;
      els.rueckCol.innerHTML = optionHtml;
      els.hinCol.value = state.columnMapping.hinfahrtColumn;
      els.rueckCol.value = state.columnMapping.rueckfahrtColumn;
      els.eventTitle.textContent = state.selectedEventName;
    }

    function getFilteredParticipants() {
      const q = (els.filterQ.value || "").trim().toLowerCase();
      const ride = els.filterRide.value || "all";
      const group = els.filterGroup.value || "all";

      return state.participants.filter((p) => {
        const fullName = `${p.Vorname} ${p.Nachname}`.toLowerCase();
        const pGroup = (p.Gruppen || "").toLowerCase();
        const matchesSearch = !q || fullName.includes(q) || pGroup.includes(q);
        const matchesGroup = group === "all" || p.Gruppen === group;
        const matchesRide = ride === "all"
          || (ride === "drivers" && (p.Hinfahrt > 0 || p.Rückfahrt > 0))
          || (ride === "passengers" && p.Hinfahrt === 0 && p.Rückfahrt === 0)
          || (ride === "hin" && p.Hinfahrt > 0)
          || (ride === "rueck" && p.Rückfahrt > 0);
        return matchesSearch && matchesGroup && matchesRide;
      });
    }

    function renderParticipants() {
      const groups = Array.from(new Set(state.participants.map((p) => p.Gruppen).filter(Boolean))).sort((a, b) => a.localeCompare(b, "de"));
      const selectedGroup = getParam("group", "all");
      els.filterGroup.innerHTML = `<option value="all">Alle Gruppen</option>${groups.map((g) => `<option value="${escapeHtml(g)}" ${g === selectedGroup ? "selected" : ""}>${escapeHtml(g)}</option>`).join("")}`;

      const filtered = getFilteredParticipants();
      els.participantsBody.innerHTML = filtered.length === 0
        ? `<tr><td colspan="4" class="px-3 py-6 text-center text-dpsg-blue/60">Keine Teilnehmer für diesen Filter</td></tr>`
        : filtered
          .map((p) => `<tr class="hover:bg-dpsg-beige-1/50"><td class="px-3 py-2 text-dpsg-blue">${escapeHtml(p.Vorname)} ${escapeHtml(p.Nachname)}</td><td class="px-3 py-2"><span class="inline-block px-2 py-0.5 rounded text-xs font-medium text-white ${getGroupColorClass(p.Gruppen)}">${escapeHtml(getShortGroupName(p.Gruppen))}</span></td><td class="px-3 py-2 text-center font-mono ${p.Hinfahrt > 0 ? "text-dpsg-pfadfinder font-bold" : "text-dpsg-blue/40"}">${p.Hinfahrt}</td><td class="px-3 py-2 text-center font-mono ${p.Rückfahrt > 0 ? "text-dpsg-pfadfinder font-bold" : "text-dpsg-blue/40"}">${p.Rückfahrt}</td></tr>`)
          .join("");

      els.modeLabel.textContent = `Live Campflow · ${state.participants.length} Teilnehmer (${filtered.length} gefiltert)`;
      els.modeDot.className = "inline-block h-2 w-2 rounded-full bg-dpsg-pfadfinder";
      els.sourceLabel.textContent = "Datenquelle: Azure SWA Function /api/campflow";
    }

    function summarize(plan) {
      const emptySeats = plan.cars.reduce((sum, car) => sum + Math.max(0, car.seatsTotal - 1 - car.passengers.length), 0);
      const overloadedCars = plan.cars.filter((car) => car.passengers.length > car.passengerCapacity).length;
      return { emptySeats, overloadedCars, leftovers: plan.leftovers.length };
    }

    function renderPlan() {
      const baseHin = computePlan(state.participants, "Hinfahrt");
      const baseRueck = computePlan(state.participants, "Rückfahrt");
      const movesHinStr = readMovesParam("movesHin");
      const movesRueckStr = readMovesParam("movesRueck");

      const planHin = applyManualMoves(baseHin, parseMovesFromUrl(movesHinStr, baseHin));
      const planRueck = applyManualMoves(baseRueck, parseMovesFromUrl(movesRueckStr, baseRueck));

      const hin = summarize(planHin);
      const rueck = summarize(planRueck);
      els.hinSummary.innerHTML = `<span class="font-semibold">Hinfahrt:</span> <span class="${hin.leftovers > 0 ? "text-dpsg-red font-semibold" : ""}">${hin.leftovers} ohne Platz</span> · ${hin.emptySeats} freie Plätze${hin.overloadedCars > 0 ? ` · <span class="text-dpsg-red font-semibold">${hin.overloadedCars} überbelegt</span>` : ""}`;
      els.rueckSummary.innerHTML = `<span class="font-semibold">Rückfahrt:</span> <span class="${rueck.leftovers > 0 ? "text-dpsg-red font-semibold" : ""}">${rueck.leftovers} ohne Platz</span> · ${rueck.emptySeats} freie Plätze${rueck.overloadedCars > 0 ? ` · <span class="text-dpsg-red font-semibold">${rueck.overloadedCars} überbelegt</span>` : ""}`;

      const sections = [["Hinfahrt", planHin], ["Rückfahrt", planRueck]];
      els.planGrid.innerHTML = sections.map(([dir, plan]) => {
        const carsHtml = plan.cars.map((car, carIndex) => {
          const passengersHtml = car.passengers.length === 0
            ? `<span class="text-sm text-dpsg-blue/50 italic">Keine Mitfahrer</span>`
            : `<div class="flex flex-wrap gap-1">${car.passengers.map((p) => `<button type="button" class="move-passenger inline-flex items-center gap-1 text-sm bg-white border border-dpsg-beige-2 rounded px-2 py-0.5 hover:border-dpsg-cyan" data-direction="${dir}" data-key="${encodeURIComponent(participantKey(p))}" data-from="${carIndex}"><span class="w-1.5 h-1.5 rounded-full ${getGroupColorClass(p.Gruppen)}"></span>${escapeHtml(p.Vorname)} ${escapeHtml(p.Nachname)}</button>`).join("")}</div>`;

          return `<div class="border border-dpsg-beige-2 rounded-lg p-3 bg-dpsg-beige-1/30"><div class="flex items-start justify-between mb-2"><div class="flex items-center gap-2"><span class="w-2 h-2 rounded-full ${getGroupColorClass(car.driver.Gruppen)}"></span><span class="font-semibold text-dpsg-blue">${escapeHtml(car.driver.Vorname)} ${escapeHtml(car.driver.Nachname)}</span></div><span class="text-sm bg-dpsg-blue text-white px-2 py-0.5 rounded">${car.passengers.length + 1}/${car.seatsTotal}</span></div>${passengersHtml}</div>`;
        }).join("");

        const leftoversHtml = plan.leftovers.length > 0
          ? `<div class="border-2 border-dashed border-dpsg-red/40 rounded-lg p-3 bg-dpsg-red/5"><div class="font-semibold text-dpsg-red mb-2">Ohne Platz (${plan.leftovers.length})</div><div class="flex flex-wrap gap-1">${plan.leftovers.map((p) => `<button type="button" class="move-passenger inline-flex items-center gap-1 text-sm bg-white border border-dpsg-red/30 text-dpsg-red rounded px-2 py-0.5 hover:border-dpsg-cyan" data-direction="${dir}" data-key="${encodeURIComponent(participantKey(p))}" data-from="-1"><span class="w-1.5 h-1.5 rounded-full ${getGroupColorClass(p.Gruppen)}"></span>${escapeHtml(p.Vorname)} ${escapeHtml(p.Nachname)}</button>`).join("")}</div></div>`
          : "";

        return `<div><div class="flex items-center justify-between mb-3"><h3 class="font-serif font-bold text-dpsg-blue">${dir}</h3><span class="text-sm px-2 py-0.5 rounded ${plan.leftovers.length > 0 ? "bg-dpsg-red/10 text-dpsg-red" : "bg-dpsg-pfadfinder/10 text-dpsg-pfadfinder"}">${plan.seatsAvailable} Plätze / ${plan.demand} Bedarf</span></div><div class="space-y-3">${carsHtml}${leftoversHtml}</div></div>`;
      }).join("");

      const csvBom = "\uFEFF";
      const csvText = csvBom + [planToCsv(planHin), planToCsv(planRueck)].join("\n\n");
      els.exportCsv.onclick = () => {
        const safeName = (state.selectedEventName || "fahrten").replace(/[^a-zA-Z0-9äöüÄÖÜß\-_]/g, "_").substring(0, 50);
        const blob = new Blob([csvText], { type: "text/csv;charset=utf-8;" });
        const dl = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = dl;
        a.download = `${safeName}_fahrten.csv`;
        a.click();
        URL.revokeObjectURL(dl);
      };

      els.copyCsv.onclick = () => {
        navigator.clipboard?.writeText(csvText).then(() => {
          els.copyCsv.textContent = "Kopiert!";
          setTimeout(() => {
            els.copyCsv.textContent = "Kopieren";
          }, 1500);
        }).catch(() => {});
      };

      document.querySelectorAll(".move-passenger").forEach((btn) => {
        btn.addEventListener("click", () => {
          const direction = btn.dataset.direction;
          const from = Number(btn.dataset.from);
          const key = decodeURIComponent(btn.dataset.key);
          const plan = direction === "Hinfahrt" ? planHin : planRueck;
          const options = plan.cars.map((car, idx) => `${idx}: ${car.driver.Vorname} ${car.driver.Nachname} (${car.passengers.length + 1}/${car.seatsTotal})`).join("\n");
          const input = window.prompt(`Ziel für ${btn.textContent.trim()}\n${options}\nl: Ohne Platz`, "l");
          if (input == null) return;
          const to = input.trim().toLowerCase() === "l" ? -1 : Number(input.trim());
          if (to < -1 || Number.isNaN(to) || to >= plan.cars.length || to === from) return;

          const paramName = direction === "Hinfahrt" ? "movesHin" : "movesRueck";
          const movesRaw = readMovesParam(paramName);
          const moves = movesRaw ? movesRaw.split(",").filter(Boolean) : [];
          const encoded = encodeURIComponent(key);
          const filteredMoves = moves.filter((m) => !m.startsWith(`${encoded}:`));
          filteredMoves.push(`${encoded}:${to === -1 ? "l" : String(to)}`);

          const nextHin = paramName === "movesHin" ? filteredMoves.join(",") : readMovesParam("movesHin");
          const nextRueck = paramName === "movesRueck" ? filteredMoves.join(",") : readMovesParam("movesRueck");
          writeMoves(nextHin, nextRueck);
          renderPlan();
        });
      });
    }

    function bindFilters() {
      els.filterQ.value = getParam("q", "");
      els.filterRide.value = getParam("ride", "all");

      const apply = () => {
        setParam("q", els.filterQ.value.trim());
        setParam("ride", els.filterRide.value === "all" ? "" : els.filterRide.value);
        setParam("group", els.filterGroup.value === "all" ? "" : els.filterGroup.value);
        renderParticipants();
      };

      els.filterRide.addEventListener("change", apply);
      els.filterGroup.addEventListener("change", apply);
      els.filterQ.addEventListener("keydown", (event) => {
        if (event.key === "Enter") apply();
      });
      els.filterQ.addEventListener("blur", apply);
    }

    async function loadParticipants() {
      const snapshot = await apiFetch({
        action: "participants",
        event: state.selectedEventId,
        hinCol: state.columnMapping.hinfahrtColumn,
        rueckCol: state.columnMapping.rueckfahrtColumn
      });
      state.participants = normalizeParticipants(snapshot.participants || []);
    }

    async function loadColumns() {
      const data = await apiFetch({ action: "columns", event: state.selectedEventId });
      state.columns = data.columns || [];
    }

    async function init() {
      buildPriorityList();
      bindFilters();
      els.resetMoves.onclick = () => {
        writeMoves("", "");
        renderPlan();
      };

      try {
        const eventsData = await apiFetch({ action: "events" });
        state.events = eventsData.events || [];

        const requestedEvent = getParam("event", "");
        const found = state.events.find((e) => e.id === requestedEvent)
          || state.events.find((e) => isWinterEvent(e.name) && e.name.includes("2026"))
          || state.events.find((e) => isWinterEvent(e.name))
          || state.events[0];

        if (!found) throw new Error("Keine Events verfügbar");

        state.selectedEventId = found.id;
        state.selectedEventName = found.name;
        setParam("event", found.id);

        state.columnMapping.hinfahrtColumn = getParam("hinCol", DEFAULT_COLUMNS.hinfahrtColumn);
        state.columnMapping.rueckfahrtColumn = getParam("rueckCol", DEFAULT_COLUMNS.rueckfahrtColumn);

        await loadColumns();
        renderEventControls();

        els.event.onchange = async () => {
          state.selectedEventId = els.event.value;
          const evt = state.events.find((e) => e.id === state.selectedEventId);
          state.selectedEventName = evt?.name || "";
          setParam("event", state.selectedEventId);
          await loadColumns();
          renderEventControls();
          await loadParticipants();
          renderParticipants();
          renderPlan();
        };

        const onColumnsChanged = async () => {
          state.columnMapping.hinfahrtColumn = els.hinCol.value;
          state.columnMapping.rueckfahrtColumn = els.rueckCol.value;
          setParam("hinCol", state.columnMapping.hinfahrtColumn);
          setParam("rueckCol", state.columnMapping.rueckfahrtColumn);
          await loadParticipants();
          renderParticipants();
          renderPlan();
        };

        els.hinCol.onchange = onColumnsChanged;
        els.rueckCol.onchange = onColumnsChanged;

        await loadParticipants();
        renderParticipants();
        renderPlan();
      } catch (error) {
        els.modeDot.className = "inline-block h-2 w-2 rounded-full bg-dpsg-red";
        els.modeLabel.textContent = "Fehler";
        els.errorBox.classList.remove("hidden");
        els.errorBox.textContent = error instanceof Error ? error.message : "Unbekannter Fehler";
      }
    }

    init();
  </script>
</BaseLayout>
